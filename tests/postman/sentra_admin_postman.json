{
  "info": {
    "name": "Sentra Admin API",
    "description": "Coleção completa para testar o plano Admin do Sentra Gateway. Fluxo recomendado: Register → Login → copiar token → testar endpoints protegidos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8001", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "tenant_id", "value": "", "type": "string" },
    { "key": "route_id", "value": "", "type": "string" },
    { "key": "user_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health",
            "description": "Verifica se o admin está rodando e se Postgres está conectado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register — usuário sem tenant",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sentra.local\",\n  \"password\": \"senha1234\"\n}"
            },
            "description": "Cria usuário admin sem tenant_id. Salva token automaticamente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('tem access_token', () => pm.expect(j.access_token).to.be.a('string'));",
                  "pm.test('tem user.id', () => pm.expect(j.user.id).to.be.a('string'));",
                  "pm.collectionVariables.set('token', j.access_token);",
                  "pm.collectionVariables.set('user_id', j.user.id);"
                ]
              }
            }
          ]
        },
        {
